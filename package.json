{
  "name": "sherif",
  "version": "1.13.0",
  "description": "Opinionated, zero-config linter for TypeScript & JavaScript monorepos",
  "keywords": [
    "cli",
    "javascript",
    "monorepo",
    "linter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuiiBz/sherif.git"
  },
  "bugs": {
    "url": "https://github.com/QuiiBz/sherif/issues"
  },
  "homepage": "https://github.com/QuiiBz/sherif#readme",
  "license": "MIT",
  "scripts": {
    "action": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
