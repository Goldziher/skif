---
source: crates/skif-cli/tests/cli.rs
expression: json.stdout
---
{
  "version": 1,
  "rules": [
    {
      "id": "empty-dependencies",
      "category": "manifest",
      "default": "error",
      "fixable": "safe",
      "summary": "A dependency section (`dependencies`, `devDependencies`, `peerDependencies`, `optionalDependencies`) is an empty object."
    },
    {
      "id": "root-package-private-field",
      "category": "manifest",
      "default": "error",
      "fixable": "safe",
      "summary": "The root `package.json` must set `\"private\": true` so it cannot be published by accident."
    },
    {
      "id": "root-package-manager-field",
      "category": "manifest",
      "default": "error",
      "fixable": "none",
      "summary": "The root `package.json` must declare the package manager in `packageManager` or `devEngines.packageManager`."
    },
    {
      "id": "root-package-dependencies",
      "category": "manifest",
      "default": "warning",
      "fixable": "unsafe",
      "summary": "The root package should only have `devDependencies`; runtime dependencies belong to the packages that use them."
    },
    {
      "id": "types-in-dependencies",
      "category": "manifest",
      "default": "error",
      "fixable": "safe",
      "summary": "A private package lists `@types/*` packages in `dependencies`; type packages belong in `devDependencies`."
    },
    {
      "id": "member-toolchain-fields",
      "category": "manifest",
      "default": "warning",
      "fixable": "unsafe",
      "summary": "Member packages should not declare `packageManager` or `engines`; the root package owns the toolchain."
    },
    {
      "id": "incompatible-peer-dependencies",
      "category": "manifest",
      "default": "warning",
      "fixable": "none",
      "summary": "The version a package installs in `devDependencies` does not satisfy the range it declares in `peerDependencies`."
    },
    {
      "id": "unsorted-dependencies",
      "category": "manifest",
      "default": "error",
      "fixable": "safe",
      "summary": "The entries of a dependency section are not in alphabetical (byte) order."
    },
    {
      "id": "unmatched-workspace-patterns",
      "category": "workspace",
      "default": "warning",
      "fixable": "safe",
      "summary": "A workspace pattern does not match any directory."
    },
    {
      "id": "missing-package-manifest",
      "category": "workspace",
      "default": "warning",
      "fixable": "unsafe",
      "summary": "A directory matched by the workspace patterns has no `package.json`."
    },
    {
      "id": "local-path-dependency",
      "category": "manifest",
      "default": "error",
      "fixable": "sometimes",
      "summary": "A dependency points at a path on disk (`link:`, `file:`, `portal:` or a relative path) instead of a registry or workspace version."
    }
  ]
}
