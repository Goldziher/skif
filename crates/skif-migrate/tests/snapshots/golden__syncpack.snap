---
source: crates/skif-migrate/tests/golden.rs
expression: migration.toml
---
#:schema https://raw.githubusercontent.com/Goldziher/skif/main/schema/skif.schema.json

# Migrated from syncpack by `skif migrate` (profile: full).
# Review the report the command printed: notes marked H or X were not translated.
# skif migrate: sources = ["syncpack"]

[policy]
dependency-types = ["prod", "dev"]
override-reading = "syncpack"

[update]
minimum-release-age = 2880
max-concurrent-requests = 4

[rules]
package-json-format = "error"

# syncpack versionGroups[0]: Pin react
[[version-groups]]
label = "Pin react"
dependencies = ["react", "react-dom"]
policy = "pinned"
pin = "18.3.1"

# syncpack versionGroups[1]: Dev tools may differ
[[version-groups]]
label = "Dev tools may differ"
packages = ["@demo/tools"]
dependency-types = ["dev"]
policy = "ignored"

# syncpack versionGroups[2]: No moment
[[version-groups]]
label = "No moment"
dependencies = ["moment"]
policy = "banned"

# syncpack versionGroups[3]: Same range for types
[[version-groups]]
label = "Same range for types"
dependencies = ["@types/**"]
policy = "same-range"

# syncpack versionGroups[4]: Follow core
[[version-groups]]
label = "Follow core"
dependencies = ["@demo/*"]
dependency-types = ["prod", "dev"]
policy = "snapped-to"
snap-to = ["@demo/core"]

# syncpack versionGroups[7]: Ranges only for plugins
[[version-groups]]
label = "Ranges only for plugins"
dependencies = ["eslint-plugin-*"]
policy = "semver-range-only"

# syncpack semverGroups[0]: Exact in prod
[[semver-groups]]
label = "Exact in prod"
dependency-types = ["prod"]
range = ""

# syncpack semverGroups[2]
[[semver-groups]]
dependency-types = ["prod"]
range = "^"

# syncpack updateGroups[0]
[[update-groups]]
dependencies = ["@types/**"]
ignored = true

# syncpack updateGroups[1]: Hold React to minors
[[update-groups]]
label = "Hold React to minors"
dependencies = ["react", "react-dom"]
target = "minor"

# syncpack customTypes.engines
[[custom-types]]
name = "engines"
path = "engines.node"
strategy = "version"

# syncpack customTypes.toolchain
[[custom-types]]
name = "toolchain"
path = "packageManager"
strategy = "name@version"

# syncpack customTypes.localish
[[custom-types]]
name = "localish"
path = "version"
strategy = "name~version"
name-path = "name"

[format]
sort-az = ["dependencies", "scripts"]
