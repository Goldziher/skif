---
source: crates/skif-edit/tests/package_json_format.rs
expression: "report(\"exports\")"
---
issues:
  - the conditions of `exports` are not in the configured order
--- before
{
  "name": "exports",
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./feature": {
      "node": {
        "default": "./dist/feature.node.js",
        "import": "./dist/feature.node.mjs"
      },
      "browser": "./dist/feature.browser.js"
    },
    "./package.json": "./package.json"
  }
}
--- after
{
  "name": "exports",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./feature": {
      "node": {
        "import": "./dist/feature.node.mjs",
        "default": "./dist/feature.node.js"
      },
      "browser": "./dist/feature.browser.js"
    },
    "./package.json": "./package.json"
  }
}
