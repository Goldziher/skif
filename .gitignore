/target
node_modules/
/dist

# poly (polylint) local cache
/.polylint

# Machine-local poly settings (hook channel preferences)
poly.local.toml

# Editor scratch
*.swp
.DS_Store
*.log

# Local secrets, never commit
.env
.env.*
!.env.example
*token*.txt

# ai-rulez harness outputs for presets this repo does not generate.
# Every file here carries the "AI-RULEZ :: GENERATED FILE" header, derived from
# .ai-rulez/, regenerable, and machine-local, so it stays out of git like the rest of
# the generated harness surface.
.cline/
.clinerules/
.continue/
.cursor/
.gemini/
.junie/
.windsurf/
GEMINI.md
.github/copilot-instructions.md
.github/agents/
.github/commands/
.github/skills/

# BEGIN ai-rulez (DO NOT EDIT - managed by ai-rulez)
.agents/skills/
.ai-rulez/.config.local.*
.ai-rulez/.generated-manifest.json
.ai-rulez/.generated-manifest.local.json
.ai-rulez/config.local.*
.ai-rulez/local/
.claude/agents/
.claude/settings.json
.claude/skills/
.codex/agents/
.codex/config.toml
.opencode/agents/
.opencode/commands/
/.mcp.json
/AGENTS.md
/CLAUDE.md
/opencode.json
# END ai-rulez


# napi-rs build outputs and the generated per-platform packages (`napi create-npm-dirs`).
/npm-package/*.node
/npm-package/index.js
/npm-package/index.d.ts
/npm-package/npm/
/npm-package/artifacts/
