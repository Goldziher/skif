{
  "name": "skif-cli",
  "version": "0.1.1",
  "description": "A dependency and package-manager linter, auditor and enforcer for JavaScript and TypeScript, with first-class monorepo support.",
  "keywords": [
    "dependencies",
    "linter",
    "monorepo",
    "workspaces",
    "pnpm",
    "npm",
    "yarn",
    "bun",
    "catalog",
    "audit"
  ],
  "homepage": "https://github.com/Goldziher/skif#readme",
  "bugs": {
    "url": "https://github.com/Goldziher/skif/issues"
  },
  "license": "MIT",
  "author": "Na'aman Hirschfeld <nhirschfeld@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Goldziher/skif.git",
    "directory": "npm-package"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "skif": "bin/skif.js"
  },
  "files": [
    "LICENSE",
    "ATTRIBUTIONS.md",
    "README.md",
    "index.js",
    "index.d.ts",
    "bin/skif.js"
  ],
  "napi": {
    "binaryName": "skif",
    "packageName": "skif",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "napi build --platform --profile node --esm --manifest-path ../crates/skif-node/Cargo.toml --output-dir . --package skif-node",
    "build:debug": "napi build --platform --esm --manifest-path ../crates/skif-node/Cargo.toml --output-dir . --package skif-node",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.12"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
