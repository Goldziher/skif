{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "root": {
      "type": "boolean",
      "description": "Stops the upward search for configuration files: no file above this one contributes. Only valid in a file\nfound by discovery, not in one reached through `extends`."
    },
    "extends": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Configuration files to inherit, relative to this file. They apply before this file does, in the order listed."
    },
    "reset": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResetKey"
      },
      "description": "Inherited lists to discard before this file applies."
    },
    "workspace": {
      "$ref": "#/$defs/Workspace",
      "description": "`[workspace]`: package-manager detection and which packages are skipped.",
      "default": {
        "ignore-packages": [],
        "discover-ignore": [
          "__fixtures__",
          "fixtures",
          "__mocks__",
          "__snapshots__"
        ]
      }
    },
    "lint": {
      "$ref": "#/$defs/Lint",
      "description": "`[lint]`: how diagnostics are reported.",
      "default": {
        "fail-on-warnings": false
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RuleConfigSchema"
      },
      "description": "`[rules]`: the level and options of every configured rule, in file order.",
      "default": {}
    },
    "ignore": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/IgnoreEntry"
      },
      "description": "`[[ignore]]`: suppressions for diagnostics.",
      "default": []
    },
    "policy": {
      "$ref": "#/$defs/Policy",
      "description": "`[policy]`: defaults for the version policies.",
      "default": {
        "prefer": "highest",
        "dependency-types": []
      }
    },
    "version-groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VersionGroup"
      },
      "description": "`[[version-groups]]`: how dependency versions must relate, first match wins.",
      "default": []
    },
    "semver-groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemverGroup"
      },
      "description": "`[[semver-groups]]`: the range type dependencies must use, first match wins.",
      "default": []
    },
    "catalog": {
      "$ref": "#/$defs/Catalog",
      "description": "`[catalog]`: when catalog entries are suggested and reported.",
      "default": {
        "mode": "off",
        "min-packages": 2,
        "exclude": [],
        "report-unused-entries": false
      }
    },
    "workspace-protocol": {
      "$ref": "#/$defs/WorkspaceProtocol",
      "description": "`[workspace-protocol]`: how dependencies on workspace packages are written.",
      "default": {
        "internal": false,
        "allow-local-paths": false
      }
    },
    "dependency-families": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DependencyFamily"
      },
      "description": "`[[dependency-families]]`: packages that must share a version.",
      "default": []
    },
    "js": {
      "$ref": "#/$defs/Js",
      "description": "`[js]`: the JavaScript and TypeScript analysis.",
      "default": {
        "enabled": true,
        "entry": [],
        "project": [],
        "ignore": [],
        "ignore-dependencies": [],
        "ignore-binaries": [],
        "production": false,
        "include-entry-exports": false,
        "workspaces": {},
        "plugins": {}
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Override"
      },
      "description": "Scoped rules for packages and files; only package-scoped keys are allowed in them."
    }
  },
  "description": "The complete `skif.toml` model.",
  "title": "Config",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ResetKey": {
      "oneOf": [
        {
          "type": "string",
          "const": "version-groups",
          "description": "Discard the inherited `version-groups`."
        },
        {
          "type": "string",
          "const": "semver-groups",
          "description": "Discard the inherited `semver-groups`."
        },
        {
          "type": "string",
          "const": "ignore",
          "description": "Discard the inherited `ignore` entries."
        },
        {
          "type": "string",
          "const": "dependency-families",
          "description": "Discard the inherited `dependency-families`."
        },
        {
          "type": "string",
          "const": "overrides",
          "description": "Discard the inherited `overrides`."
        }
      ],
      "description": "The inherited lists that `reset` can discard."
    },
    "Workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ignore-packages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Package names or globs excluded from every check.",
          "default": []
        },
        "package-manager": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageManager"
            },
            {
              "type": "null"
            }
          ],
          "description": "Overrides package-manager detection."
        },
        "discover-ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Gitignore-style patterns, relative to the directory a recursive run starts in, of directories that root\ndiscovery (`-r`) does not enter, so no project below them is found. A bare name matches at any depth; a\npattern with a slash is anchored at the start directory. Replaces the default list\n(`__fixtures__`, `fixtures`, `__mocks__`, `__snapshots__`); `[]` skips nothing. Read from the configuration\nfile that governs the start directory.",
          "default": [
            "__fixtures__",
            "fixtures",
            "__mocks__",
            "__snapshots__"
          ]
        },
        "extend-ignore-packages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Appended to `ignore-packages` instead of replacing it. Folded away when the configuration is resolved."
        }
      },
      "description": "`[workspace]`"
    },
    "PackageManager": {
      "oneOf": [
        {
          "type": "string",
          "const": "npm",
          "description": "npm."
        },
        {
          "type": "string",
          "const": "pnpm",
          "description": "pnpm."
        },
        {
          "type": "string",
          "const": "yarn",
          "description": "Yarn."
        },
        {
          "type": "string",
          "const": "bun",
          "description": "Bun."
        }
      ],
      "description": "Package managers that can be forced with `[workspace] package-manager`."
    },
    "Lint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fail-on-warnings": {
          "type": "boolean",
          "description": "Exit non-zero when only warnings were reported.",
          "default": false
        },
        "max-level": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ],
          "description": "Caps the severity of every diagnostic: a rule configured above this level reports at it."
        }
      },
      "description": "`[lint]`"
    },
    "Level": {
      "oneOf": [
        {
          "type": "string",
          "const": "off",
          "description": "The rule does not run."
        },
        {
          "type": "string",
          "const": "info",
          "description": "Diagnostics are informational."
        },
        {
          "type": "string",
          "const": "warn",
          "description": "Diagnostics are warnings."
        },
        {
          "type": "string",
          "const": "error",
          "description": "Diagnostics are errors."
        }
      ],
      "description": "The level a rule is configured to: `off`, `info`, `warn` or `error`."
    },
    "RuleConfigSchema": {
      "anyOf": [
        {
          "$ref": "#/$defs/Level"
        },
        {
          "$ref": "#/$defs/RuleTableSchema"
        }
      ],
      "description": "Schema stand-in for a `[rules]` value: a level string or a table of `level` plus options.\nIt only describes the shape for the JSON Schema and is never constructed."
    },
    "RuleTableSchema": {
      "type": "object",
      "properties": {
        "level": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ],
          "description": "The level of the rule; the key that is written back. Set either `level` or `severity`, not both."
        },
        "severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ],
          "description": "Alias of `level`."
        }
      },
      "additionalProperties": true,
      "description": "Table form of a rule entry; the options present depend on the rule."
    },
    "IgnoreEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Rule IDs to suppress; an empty list does not narrow the entry by rule.",
          "default": []
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Package names or directories; an empty selector matches every package.",
          "default": []
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Dependency names; an empty selector matches every dependency.",
          "default": []
        }
      },
      "description": "One `[[ignore]]` suppression. An empty list does not narrow that dimension, but at least one list must be set:\nan entry without any filter is rejected as it would suppress everything."
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefer": {
          "$ref": "#/$defs/Prefer",
          "description": "Which version `preferred-semver` favours.",
          "default": "highest"
        },
        "dependency-types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Dependency types the policy rules apply to. Empty means production and development dependencies (`dependencies` and `devDependencies`); name `peer` or `optional` to include them.",
          "default": []
        }
      },
      "description": "`[policy]`"
    },
    "Prefer": {
      "oneOf": [
        {
          "type": "string",
          "const": "highest",
          "description": "Prefer the highest version in use."
        },
        {
          "type": "string",
          "const": "lowest",
          "description": "Prefer the lowest version in use."
        }
      ],
      "description": "Which version `preferred-semver` favours."
    },
    "VersionGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "A name shown in diagnostics."
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Dependency names the group covers; empty covers every dependency.",
          "default": []
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Package names the group covers; empty covers every package.",
          "default": []
        },
        "dependency-types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Dependency types the group covers; empty covers every type.",
          "default": []
        },
        "specifier-types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Specifier types the group covers (`exact`, `range`, `tag`, ...), optionally negated with `!`; empty covers every type.",
          "default": []
        },
        "policy": {
          "$ref": "#/$defs/VersionPolicy",
          "description": "The policy the group enforces.",
          "default": "preferred-semver"
        },
        "pin": {
          "type": [
            "string",
            "null"
          ],
          "description": "Required by `pinned`."
        },
        "snap-to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Required by `snapped-to`: packages whose version the group follows.",
          "default": []
        },
        "prefer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Prefer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Allowed with `preferred-semver`; overrides `[policy] prefer`."
        }
      },
      "description": "One `[[version-groups]]` entry; first match wins. Selectors accept `!` negation and `$LOCAL`."
    },
    "VersionPolicy": {
      "oneOf": [
        {
          "type": "string",
          "const": "pinned",
          "description": "Every matched dependency must use the `pin` version."
        },
        {
          "type": "string",
          "const": "banned",
          "description": "The matched dependencies must not be used."
        },
        {
          "type": "string",
          "const": "ignored",
          "description": "The matched dependencies are not checked."
        },
        {
          "type": "string",
          "const": "same-range",
          "description": "Every range must overlap every other range."
        },
        {
          "type": "string",
          "const": "same-minor",
          "description": "Every matched dependency must share a major and minor version."
        },
        {
          "type": "string",
          "const": "snapped-to",
          "description": "Versions must match those declared by the `snap-to` packages."
        },
        {
          "type": "string",
          "const": "preferred-semver",
          "description": "Versions must match the highest or lowest one in use."
        }
      ],
      "description": "The policy of a version group."
    },
    "SemverGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "A name shown in diagnostics."
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Dependency names the group covers; empty covers every dependency.",
          "default": []
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Package names the group covers; empty covers every package.",
          "default": []
        },
        "dependency-types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Dependency types the group covers; empty covers every type.",
          "default": []
        },
        "specifier-types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Specifier types the group covers, optionally negated with `!`; empty covers every type.",
          "default": []
        },
        "range": {
          "$ref": "#/$defs/SemverRange",
          "description": "The range type the matched dependencies must use."
        }
      },
      "required": [
        "range"
      ],
      "description": "One `[[semver-groups]]` entry; first match wins."
    },
    "SemverRange": {
      "oneOf": [
        {
          "type": "string",
          "const": "",
          "description": "No range operator: an exact version."
        },
        {
          "type": "string",
          "const": "*",
          "description": "Any version (`*`)."
        },
        {
          "type": "string",
          "const": "^",
          "description": "Compatible versions (`^`)."
        },
        {
          "type": "string",
          "const": "~",
          "description": "Patch-level changes (`~`)."
        },
        {
          "type": "string",
          "const": ">",
          "description": "Greater than (`>`)."
        },
        {
          "type": "string",
          "const": ">=",
          "description": "Greater than or equal (`>=`)."
        },
        {
          "type": "string",
          "const": "<",
          "description": "Less than (`<`)."
        },
        {
          "type": "string",
          "const": "<=",
          "description": "Less than or equal (`<=`)."
        }
      ],
      "description": "The range type a semver group enforces."
    },
    "Catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/CatalogMode",
          "description": "How strongly catalogs are preferred.",
          "default": "off"
        },
        "min-packages": {
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "description": "Minimum number of packages using a dependency before a catalog entry is suggested.",
          "default": 2
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Dependencies never suggested for a catalog.",
          "default": []
        },
        "report-unused-entries": {
          "type": "boolean",
          "description": "Report catalog entries no package references.",
          "default": false
        },
        "extend-exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Appended to `exclude` instead of replacing it. Folded away when the configuration is resolved."
        }
      },
      "description": "`[catalog]`"
    },
    "CatalogMode": {
      "oneOf": [
        {
          "type": "string",
          "const": "off",
          "description": "Catalog rules suggest nothing."
        },
        {
          "type": "string",
          "const": "prefer",
          "description": "Suggest moving shared dependencies into a catalog."
        },
        {
          "type": "string",
          "const": "enforce",
          "description": "Require shared dependencies to come from a catalog."
        }
      ],
      "description": "`[catalog] mode`"
    },
    "WorkspaceProtocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "internal": {
          "type": "boolean",
          "description": "Require `workspace:` for dependencies on other workspace packages.",
          "default": false
        },
        "allow-local-paths": {
          "type": "boolean",
          "description": "Accept `file:` / `link:` paths for internal dependencies.",
          "default": false
        }
      },
      "description": "`[workspace-protocol]`"
    },
    "DependencyFamily": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "The family name; a built-in family of the same name is replaced."
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Package names or globs that must share a version.",
          "default": []
        },
        "enabled": {
          "type": "boolean",
          "description": "`false` disables a built-in family of the same name.",
          "default": true
        }
      },
      "required": [
        "name"
      ],
      "description": "One `[[dependency-families]]` entry: packages that must share a version."
    },
    "Js": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Run the JavaScript analysis.",
          "default": true
        },
        "entry": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Entry-point globs, added to the ones plugins and `package.json` provide.",
          "default": []
        },
        "project": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Globs of the files that belong to the project.",
          "default": []
        },
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Globs of files that are not analysed.",
          "default": []
        },
        "ignore-dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Dependencies never reported as unused or unlisted.",
          "default": []
        },
        "ignore-binaries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Binaries never reported as unlisted.",
          "default": []
        },
        "production": {
          "type": "boolean",
          "description": "Analyse production code only.",
          "default": false
        },
        "include-entry-exports": {
          "type": "boolean",
          "description": "Report unused exports of entry files too.",
          "default": false
        },
        "workspaces": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsWorkspace"
          },
          "description": "Per-workspace overrides keyed by directory.",
          "default": {}
        },
        "plugins": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PluginConfig"
          },
          "description": "Plugin switches keyed by plugin name.",
          "default": {}
        },
        "extend-ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Appended to `ignore` instead of replacing it. Folded away when the configuration is resolved."
        },
        "extend-ignore-dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Appended to `ignore-dependencies` instead of replacing it. Folded away when the configuration is resolved."
        },
        "extend-ignore-binaries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Appended to `ignore-binaries` instead of replacing it. Folded away when the configuration is resolved."
        }
      },
      "description": "`[js]`"
    },
    "JsWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Entry-point globs relative to the workspace directory.",
          "default": []
        },
        "project": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Project file globs relative to the workspace directory.",
          "default": []
        },
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Globs of files that are not analysed.",
          "default": []
        },
        "ignore-dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Dependencies never reported as unused or unlisted.",
          "default": []
        },
        "ignore-binaries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Binaries never reported as unlisted.",
          "default": []
        }
      },
      "description": "`[js.workspaces.\"<dir>\"]`"
    },
    "PluginConfig": {
      "anyOf": [
        {
          "type": "boolean",
          "description": "A bare switch: `true` forces the plugin on, `false` off."
        },
        {
          "$ref": "#/$defs/PluginOptions",
          "description": "The table form with options."
        }
      ],
      "description": "`[js.plugins] <name> = true | { ... }`"
    },
    "PluginOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Forces the plugin on or off; unset keeps its detection."
        },
        "config": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Config-file globs the plugin reads.",
          "default": []
        },
        "entry": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Entry-point globs the plugin contributes.",
          "default": []
        },
        "project": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Project file globs the plugin contributes.",
          "default": []
        }
      },
      "description": "Table form of a plugin entry."
    },
    "Override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Package names, or directories (`./apps/old/**`). At least one of `packages` and `files` must be set."
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "File globs. When both lists are set, a diagnostic must match both."
        },
        "max-level": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ],
          "description": "Caps the severity of every matched diagnostic."
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/RuleConfigSchema"
          },
          "description": "Rule levels; options are root-scoped and not allowed here."
        },
        "ignore": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IgnoreEntry"
          },
          "description": "Suppressions limited to the selected packages and files; an entry may omit every filter."
        },
        "js": {
          "$ref": "#/$defs/PackageJs",
          "description": "JavaScript inputs for the selected packages; needs `packages` and no `files`."
        }
      },
      "description": "One `[[overrides]]` entry: settings for the packages and files it selects.\n\nPatterns are anchored at the directory of the file that declares them: a package pattern starting with `./` is a\ndirectory below it, any other is a package name (or a `$LOCAL`-style token); a file pattern is always a path\nbelow it. A `$ROOT/` prefix anchors a pattern at the root being linted instead, and a path that would leave the\nanchor never matches.\n\nOnly package-scoped keys are allowed. An override never changes what a workspace-wide analysis computes; it\nchanges how the diagnostics located in the selected packages or files are reported, and the JavaScript inputs of\nthe selected packages."
    },
    "PackageJs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Replaces the entry globs."
        },
        "project": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Replaces the project globs."
        },
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Replaces the ignore globs."
        },
        "ignore-dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Replaces the ignored dependencies."
        },
        "ignore-binaries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Replaces the ignored binaries."
        },
        "extend-ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Appended to the ignore globs."
        },
        "extend-ignore-dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Appended to the ignored dependencies."
        },
        "extend-ignore-binaries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Appended to the ignored binaries."
        },
        "plugins": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PluginConfig"
          },
          "description": "Plugin switches and options for the selected packages."
        }
      },
      "description": "`[js]` keys an override can set for the packages it selects.\n\nGlobs are relative to each selected package. The `extend-*` keys append to what the package inherits; the others\nreplace it."
    }
  }
}
